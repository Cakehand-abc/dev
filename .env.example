# Copy values into environment variables. Spring Boot does not load this file automatically.
# PowerShell: $env:DB_PASSWORD = 'your password'
DB_URL=jdbc:mysql://127.0.0.1:3306/smart_care?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=Asia/Shanghai
DB_USERNAME=smart_care
DB_PASSWORD=replace-with-database-password
APP_ADMIN_PASSWORD=replace-with-at-least-12-characters
SPRING_PROFILES_ACTIVE=demo
APP_SEED_DEMO=true
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
